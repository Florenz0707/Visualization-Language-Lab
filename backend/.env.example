# Example environment variables for backend
# HOST/PORT used by run_server.py
HOST=127.0.0.1
PORT=8000
RELOAD=0

# Cache tuning for src/services/data_loader.py
# Sizes are integers; defaults in code: GEOJSON=128, GDF=32, REPROJECT=64
GEOJSON_CACHE_SIZE=128
GDF_CACHE_SIZE=32
REPROJECT_CACHE_SIZE=64

# GZipMiddleware
GZIP_MIN_SIZE=500
